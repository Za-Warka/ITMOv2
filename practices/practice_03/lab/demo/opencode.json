{
  "$schema": "https://opencode.ai/config.json",
  "model": "lm-studio/itmo-agent",
  "small_model": "lm-studio/itmo-agent",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "lm-studio" 
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "qwen/qwen3.5-9b"
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}

