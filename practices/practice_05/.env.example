# Optional server-only token for higher GitHub API limits.
GITHUB_TOKEN=

# Optional persistent server-only secret for anonymous author IDs.
AUTHOR_HASH_SECRET=

# Go backend OAuth and session settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://127.0.0.1:8080/auth/github/callback
SESSION_SECRET=
DATABASE_PATH=./backend/data/repo-atlas.db
FRONTEND_URL=http://127.0.0.1:3000
GO_API_URL=http://127.0.0.1:8080
PORT=8080
SECURE_COOKIES=false
