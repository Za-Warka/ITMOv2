# GitHub OAuth application settings. Keep secrets empty in committed examples.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://127.0.0.1:8080/auth/github/callback

# Required before enabling OAuth routes.
SESSION_SECRET=

DATABASE_PATH=./data/repo-atlas.db
FRONTEND_URL=http://127.0.0.1:3000
PORT=8080
SECURE_COOKIES=false
