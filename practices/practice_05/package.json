{
  "name": "repo-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:all": "bash scripts/start-local.sh",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests mcp scripts hooks",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "mcp": "tsx mcp/server.ts",
    "mcp:verify": "tsx scripts/verify-mcp.ts",
    "check:watch": "node scripts/watch-check.mjs",
    "format": "prettier --write src tests mcp scripts next.config.ts eslint.config.mjs vitest.config.ts",
    "hook:demo": "node scripts/demo-hook.mjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
